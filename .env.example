# -----------------------------
# Gemini
# -----------------------------
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# -----------------------------
# Gmail OAuth
# -----------------------------
# Create a Google OAuth Desktop App and generate a refresh token.
GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_google_refresh_token

# -----------------------------
# MailMind preferences
# -----------------------------
USER_CONTEXT=Student interested in AI/ML, internships, scholarships, fellowships, hackathons, conferences, research and career opportunities.
MAX_EMAILS=30
GMAIL_QUERY=newer_than:14d
REPORT_INTERVAL_DAYS=3

# Optional local SQLite path
DATABASE_PATH=mailmind.db

# Optional local-only agent seed
AGENT_SEED=change-this-for-local-development
